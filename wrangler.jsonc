{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "cbs_backend",
    "main": "src/index.ts",
    "compatibility_date": "2024-09-23",
    "compatibility_flags": [
      "nodejs_compat"
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "SmartConsult_db",
        "database_id": "25e1c59a-2faa-4427-b1b2-0455ab27b658"
      }
    ],
    "vars": {
      "NODE_ENV": "development",
      "CASHFREE_API_VERSION": "2022-09-01",
      "FRONTEND_URL": "http://localhost:3000",
      "ZOHO_CLIENT_ID": "",
      "ZOHO_CLIENT_SECRET": "",
      "ZOHO_REFRESH_TOKEN": ""
    }
  } 